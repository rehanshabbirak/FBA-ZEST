# Copy to .env.local and fill in. .env.local is gitignored.

# From https://sanity.io/manage → your project → Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional. Pinned in src/sanity/env.ts if omitted.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Editor-role token from manage.sanity.io → API → Tokens.
# Only needed to run `npm run seed`; never exposed to the browser.
SANITY_API_WRITE_TOKEN=

# Any random string. Must match the secret on the Sanity webhook that points
# at /api/revalidate.
SANITY_REVALIDATE_SECRET=
